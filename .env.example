# Copier ce fichier en .env (non versionné) et adapter les valeurs.
# Connexion MySQL/MariaDB du module livres (XAMPP : root sans mot de passe par défaut).
BOOKS_DB_HOST=127.0.0.1
BOOKS_DB_PORT=3306
BOOKS_DB_USER=root
BOOKS_DB_PASSWORD=
BOOKS_DB_NAME=recommendation_mvp

# Attribut Secure du cookie de session : auto (HTTPS détecté), true ou false.
# En développement sur http://127.0.0.1, laisser auto.
BOOKS_COOKIE_SECURE=auto
